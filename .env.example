# ==============================
# JSSG API - Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# ==============================

# --- App ---
APP_NAME=JSSG API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Async SQLAlchemy URL for the application:
DATABASE_URL=postgresql+asyncpg://jssg:jssg_secret@localhost:5432/jssg_db
# Alembic swaps asyncpg -> psycopg2 automatically.

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=jssg-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Payment Gateway ---
PAYMENT_PROVIDER=
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# --- OTP Login ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5

# --- SMS Gateway ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# --- MSG91 OTP Widget (server-side access-token verification) ---
# Authkey from MSG91 account (Server-Side Integration). Secret - server only.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
# MSG91_VERIFY_URL=https://control.msg91.com/api/v5/widget/verifyAccessToken
# MSG91_SEND_OTP_URL=https://api.msg91.com/api/v5/widget/sendOtp
# MSG91_VERIFY_OTP_URL=https://api.msg91.com/api/v5/widget/verifyOtp
# MSG91_TIMEOUT_SECONDS=10.0
