# ==============================
# JSSG API - Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# ==============================

# --- App ---
APP_NAME=JSSG API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Async SQLAlchemy URL for the application:
DATABASE_URL=postgresql+asyncpg://jssg:jssg_secret@localhost:5432/jssg_db
# Alembic swaps asyncpg -> psycopg2 automatically.

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare R2 ---
# Optional. Without it, media is stored in Postgres (see MEDIA_STORAGE_BACKEND),
# which works on serverless hosts where local disk does not.
#
# CLOUDFLARE_R2_ENDPOINT must be the S3 API host below; the public r2.dev domain
# and custom public domains cannot accept signed requests. CLOUDFLARE_R2_ACCESS_KEY
# / CLOUDFLARE_R2_SECRET_KEY are the "R2 API Token" access key pair from the R2
# page, not an API token, a Global API key or the account ID. Any value pasted
# with a trailing newline or surrounding quotes is trimmed on load, because an
# extra character is signed and shows up as SignatureDoesNotMatch.
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=jssg-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com

# Where uploaded media is kept: auto (R2 if configured, else Postgres), r2,
# database, or local. "local" writes to the system temp dir and is for
# development only - files are not shared between instances and vanish on a
# cold start.
MEDIA_STORAGE_BACKEND=auto

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=jssg-7e2b0
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Payment Gateway ---
PAYMENT_PROVIDER=
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# --- OTP Login ---
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5

# --- SMS Gateway ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# --- MSG91 OTP ---
# Recommended mode: standard OTP API (no widget CAPTCHA/anti-bot guard).
# Authkey from MSG91 account (Server-Side Integration). Secret - server only.
MSG91_AUTH_KEY=
# OTP Template ID from MSG91 dashboard -> OTP -> Templates (must be DLT-approved
# for OTP SMS to be delivered to phones).
# When set, calls use https://control.msg91.com/api/v5/otp (authkey-based).
MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_API_URL=https://control.msg91.com/api/v5/otp
# MSG91_OTP_VERIFY_URL=https://control.msg91.com/api/v5/otp/verify

# --- MSG91 OTP Widget (fallback only, has CAPTCHA/anti-bot protection) ---
# Used only when MSG91_OTP_TEMPLATE_ID is empty.
# Widget ID + auth token from the MSG91 OTP Widget dashboard.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
# MSG91_VERIFY_URL=https://control.msg91.com/api/v5/widget/verifyAccessToken
# MSG91_SEND_OTP_URL=https://control.msg91.com/api/v5/widget/sendOtpMobile
# MSG91_VERIFY_OTP_URL=https://control.msg91.com/api/v5/widget/verifyOtp
# MSG91_TIMEOUT_SECONDS=10.0

# --- Google Sheets registration sync (POST /api/registration/sync-google-sheet) ---
# Service-account credentials. Provide EITHER the absolute path to a key file
# (keep it OUTSIDE the repo, or name it so .gitignore matches) ...
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/jssg-sheets-reader.json
# ... OR paste the whole JSON on one line (keep "\n" inside private_key).
# Never commit the key: the *service-account*.json / credentials.json /
# google-credentials*.json / gcp-*.json / gcloud-key*.json patterns are gitignored.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Share the spreadsheet with the service account's client_email as Viewer.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
# Optional overrides; defaults are 1 and 2 (header row / first data row).
# GOOGLE_SHEETS_HEADER_ROW=1
# GOOGLE_SHEETS_DATA_START_ROW=2
# A1 notation, when set, replaces the sheet name + row numbers above.
# GOOGLE_SHEETS_RANGE=Form Responses 8!A1:AF
# Kill switch for real writes. Leave false until the dry run is reviewed; even
# with dry_run=true the endpoint never writes, and setting this to true is still
# required before any row is inserted.
GOOGLE_SHEETS_SYNC_ENABLED=true
