{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{tests/**,**/*.test.py,fixtures/**,.venv/**,.mypy_cache/**,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "crons": [
    {
      "path": "/api/registration/sync-google-sheet",
      "schedule": "*/10 * * * *"
    }
  ]
}
